# --- Basis ---
NODE_ENV=development
PORT=3000
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leads
# Nur bei externer DB mit TLS-Pflicht (Railway-intern nicht nötig)
DATABASE_SSL=false
EVENT_CONFIG_PATH=config/event.json

# --- Sicherheit (in Produktion Pflicht) ---
# z. B. `openssl rand -base64 48`
APP_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=
# Datenexport GET /export/data.json (Header: Authorization: Bearer <key>), mind. 32 Zeichen.
# Leer = Endpunkt aus. Erzeugen z. B. mit `openssl rand -base64 36`; nach dem Export wieder entfernen.
EXPORT_API_KEY=

# --- SMS ---
# twilio | seven | console
SMS_PROVIDER=console
# Alphanumerischer Absender (max. 11 Zeichen, seven.io)
SMS_SENDER=Rotary
# Erlaubte Länder für Handynummern (Schutz vor SMS-Kostenmissbrauch)
SMS_ALLOWED_COUNTRIES=DE
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SEVEN_API_KEY=

# --- Verifizierung ---
# Es werden keine E-Mails versendet (keine Code-Bestätigung, keine Abschluss-Mail).
# Optionale SMS-Verifizierung (benötigt SMS_PROVIDER); aktuell nicht genutzt
VERIFY_PHONE=false
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_RESEND_COOLDOWN_SECONDS=30
CODE_MAX_SENDS_PER_TARGET_PER_HOUR=5

# --- Glücksrad ---
# false = physisches Glücksrad am Stand (Ergebnis wird eingegeben), true = virtuelles Glücksrad in der App
VIRTUAL_WHEEL=false
